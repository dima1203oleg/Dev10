{
  "name": "tenderai-foultender-suite",
  "private": true,
  "version": "0.1.0-rc.1",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server.cjs",
    "start": "node server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','server.cjs','server.cjs.map'])fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_DB_INTEGRATION_TESTS=true vitest run src/tests/rls.integration.test.ts",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "verify": "npm run lint && npm test && npm run build && npm run audit:dependencies",
    "verify:clean": "npm ci --ignore-scripts && npm run verify"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
